local function isInPlot(plot, pos)
    if not plot or not plot:IsA("Model") then return false end
    local success, cf, size = pcall(function() return plot:GetBoundingBox() end)
    if not success or not cf or not size then return false end

    local rel = cf:PointToObjectSpace(pos)
    return math.abs(rel.X) <= size.X/2 and math.abs(rel.Y) <= size.Y/2 and math.abs(rel.Z) <= size.Z/2
end

local myDedicatedBase = nil

local function isInAnyBase()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return false end

    if myDedicatedBase and myDedicatedBase.Parent and myDedicatedBase:IsA("Model") and isInPlot(myDedicatedBase, hrp.Position) then
        return true, myDedicatedBase
    end

    for _, plot in pairs(plotsFolder:GetChildren()) do
        if plot ~= myDedicatedBase and plot:IsA("Model") and isInPlot(plot, hrp.Position) then
            return true, plot
        end
    end
    return false
end

local function SetupHomeBase()
