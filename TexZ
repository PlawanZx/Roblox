local function CoreFarmProcess()
    local character = localPlayer.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local holdTime = tonumber(_G.HoldTime) or 0.2

    if hrp and hum then
        local originalSpeed = hum.WalkSpeed
        hum.WalkSpeed = 0
        character:PivotTo(chargeCFrame)
        task.wait(0.7)

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        task.wait(holdTime)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)

        pcall(function() if hum and hum.Parent then hum.WalkSpeed = originalSpeed end end)
    end
end

local function StartAutoLoopSystem()
    if _G.MainLoopRunning then return end
    _G.MainLoopRunning = true
    SetupHomeBase()

    while _G.AutoLoopEnabled and isUiEnabled do
        local character = localPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if hrp then
            local inBase = isInAnyBase()
            local distToCharge = (hrp.Position - chargeCFrame.Position).Magnitude

            if not inBase and distToCharge < 100 then
                if myDedicatedBase then
                    local plotCF, _ = myDedicatedBase:GetBoundingBox()
                    if plotCF then
                        character:PivotTo(plotCF + Vector3.new(0, 3, 0))
                        task.wait(1.5)
                        inBase = isInAnyBase()
                    end
                else
                    SetupHomeBase()
                end
            end

            if inBase then
                task.wait(1)
                if _G.AutoLoopEnabled and isUiEnabled then
                    CoreFarmProcess()
                    task.wait(3)

                    local waitTime = 0
                    local maxWait = 15
                    repeat
                        task.wait(1)
                        waitTime = waitTime + 1
                        local curHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if not curHrp then break end
                        if isInAnyBase() or (curHrp.Position - chargeCFrame.Position).Magnitude < 100 then break end
                    until waitTime >= maxWait or not _G.AutoLoopEnabled or not isUiEnabled
                end
            end
        end
        task.wait(1)
    end
    _G.MainLoopRunning = false
end

