task.spawn(function()
    task.wait(2.0)
    local kavoGui = nil

    for _, gui in pairs(CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui:FindFirstChild("Main") then
            kavoGui = gui
            if gui.Main:FindFirstChild("CustomProfile") then
                gui.Main.CustomProfile:Destroy()
            end
        end
    end

    if not kavoGui then return end
    local mainFrame = kavoGui.Main

    -- ✅ ===== แก้บัคมือถือ: Scale + Drag =====
    if isMobile then
        -- ลบ UIScale เก่าถ้ามี
        local existingScale = mainFrame:FindFirstChildOfClass("UIScale")
        if existingScale then existingScale:Destroy() end

        -- ย่อ UI ให้พอดีจอมือถือ (ปรับค่า Scale ได้ 0.55~0.65)
        local uiScale = Instance.new("UIScale")
        uiScale.Scale = 0.62
        uiScale.Parent = mainFrame

        -- จัดตำแหน่งให้อยู่กลางจอด้านบน
        task.wait(0.1)
        mainFrame.Position = UDim2.new(0.5, -(mainFrame.AbsoluteSize.X * 0.62) / 2, 0.05, 0)

        -- ✅ เพิ่มระบบลากด้วยนิ้ว เฉพาะแถบหัวเท่านั้น (ไม่บล็อก Scroll)
        local dragging = false
        local dragStart = nil
        local frameStartPos = nil
        local TOPBAR_HEIGHT = 50 -- px (ความสูงแถบหัวสำหรับลาก)

        -- ฟังก์ชันเช็คว่านิ้วอยู่ในโซนแถบหัวของหน้าต่างหรือเปล่า
        local function isTouchOnTopBar(touchPos)
            local frameAbsY = mainFrame.AbsolutePosition.Y
            local relY = touchPos.Y - frameAbsY
            -- อยู่ใน 50px บนสุดของหน้าต่าง = โซนลาก
            return relY >= 0 and relY <= TOPBAR_HEIGHT
        end

        -- ✅ ใช้ UserInputService แทน InputBegan บน Frame
        -- เพื่อให้ ScrollingFrame ยังรับ touch ได้ตามปกติ
        UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                if isTouchOnTopBar(input.Position) then
                    dragging = true
                    dragStart = input.Position
                    frameStartPos = mainFrame.Position
                end
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                mainFrame.Position = UDim2.new(
                    frameStartPos.X.Scale,
                    frameStartPos.X.Offset + delta.X,
                    frameStartPos.Y.Scale,
                    frameStartPos.Y.Offset + delta.Y
                )
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end
    -- ✅ ===== จบส่วน Mobile Fix =====

    -- กรอบโปรไฟล์แบบโปร่งใส
