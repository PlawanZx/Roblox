    if _G.RunwayConnection then _G.RunwayConnection:Disconnect() end
    _G.RunwayConnection = RunService.Heartbeat:Connect(function()
        if not _G.AutoLoopEnabled and not _G.QteScannerActive then return end
        local char = localPlayer.Character
