-- ✅ ฟังก์ชันกดปุ่ม (รองรับทั้ง PC และ มือถือ แบบแม่นยำ)
local function clickButton(button)
    -- ใช้ GuiInset คำนวณขอบจออัตโนมัติ แทนการบวก 58 ดื้อๆ
    local inset = GuiService:GetGuiInset()
    local x = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
    local y = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2) + inset.Y

    if isMobile then
        -- มือถือ: ใช้ SendTouchEvent ต้องระบุ State (0 = แตะ, 2 = ปล่อย)
        local id = math.random(1, 1000000)
        VirtualInputManager:SendTouchEvent(id, 0, x, y) -- State 0: แตะลงไป
        task.wait(0.05)
        VirtualInputManager:SendTouchEvent(id, 2, x, y) -- State 2: ยกนิ้วขึ้น
    else
        -- PC: ใช้ SendMouseButtonEvent
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1) -- กด
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1) -- ปล่อย
    end
end

-- ✅ Toggle Auto QTE
local running = false -- เพิ่มตัวแปรกันบัค
Section1:NewToggle("กดปุ่ม x2 อัตโนมัติ", "กดปุ่ม x2 อัตโนมัติ (ลู่วิ่ง)", function(state)
    running = state
    if running then
        print("Auto QTE ลู่วิ่ง เปิดแล้ว | Platform: " .. (isMobile and "Mobile" or "PC"))
        task.spawn(function()
            while running and task.wait(0.05) do
                local b = PlayerGui:FindFirstChild("TreadmillQTE_Icon")
                b = b and b:FindFirstChildOfClass("Frame")
                b = b and b:FindFirstChildOfClass("ImageButton")

                if b and b.Visible then
                    clickButton(b)
                end
            end
        end)
    else
        print("Auto QTE ลู่วิ่ง ปิดแล้ว")
    end
end)

local antiAFKConnection

Section1:NewToggle("Anti AFK (ดันโดนเตะ)", "ป้องกันการ AFK", function(state)
    if state then
        print("Anti AFK เปิดแล้ว")
        local VirtualUser = game:GetService("VirtualUser")
        antiAFKConnection = localPlayer.Idled:Connect(function()
            VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        end)
    else
        print("Anti AFK ปิดแล้ว")
        if antiAFKConnection then
            antiAFKConnection:Disconnect()
            antiAFKConnection = nil
        end
    end
end)

