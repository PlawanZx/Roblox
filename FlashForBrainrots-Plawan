                    pcall(function() event:InvokeServer("Pay", selectedPayMode.payload) end)
                    if selectedPayMode.times > 1 then
                        task.wait(0.05) -- หน่วงเวลากรณีตั้งให้รัวจ่าย
                    end
                end
                
                -- 2) จำลองกดปุ่มเลข 1 (ถ้าผู้ใช้เปิดฟังก์ชันนี้ในหน้า UI)
