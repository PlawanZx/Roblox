        local currentText = txtTime.Text
        
        if string.find(currentText, "RAID AVAILABLE!") then
            if lastAction ~= "เขียว" then
                isLocked = true
                lastAction = "เขียว"
                task.wait(20) 
                
                local character = player.Character or player.CharacterAdded:Wait()
                local rootPart = character:WaitForChild("HumanoidRootPart")
                
                stopRaid = false
                rootPart.CFrame = CFrame.new(tpTarget)
                task.wait(0.3)

                if not charging then
                    charging = true
                    task.spawn(ActionChargeButton)
                end

                task.wait(0.5)
                isLocked = false
            end
            
        elseif string.find(currentText, "Raid in") then
            if lastAction ~= "แดง" then
                isLocked = true
                lastAction = "แดง"
                stopRaid = true

                local character = player.Character or player.CharacterAdded:Wait()
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then rootPart.CFrame = CFrame.new(tpTarget) end

                -- 1) ทำงานตามรูปแบบเงินที่เลือกจากเมนู Dropdown
