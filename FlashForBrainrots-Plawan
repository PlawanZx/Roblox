                    task.spawn(function()
                        task.wait(0.1) -- รอให้จ่ายเงินเสร็จสักแป๊บนึง
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                    end)
                end
                
                task.wait(0.5)
                isLocked = false
            end
        end
    end

    txtTime:GetPropertyChangedSignal("Text"):Connect(onTextChangedFunction)
end)

