-- 5. ฟังก์ชันการทำงานหลัก (Logic)
-- ==========================================
local function getModelBounds(model)
    if not model then return end
    return model:GetBoundingBox()
end

local function isInPlot(plot, pos)
    local cf, size = getModelBounds(plot)
    if not cf then return false end
    local rel = cf:PointToObjectSpace(pos)
    return math.abs(rel.X) <= size.X/2 and math.abs(rel.Y) <= size.Y/2 and math.abs(rel.Z) <= size.Z/2
end

local function isInAnyPlot()
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return false end

    for _, plot in pairs(plotsFolder:GetChildren()) do
        if plot:IsA("Model") and isInPlot(plot, hrp.Position) then
            return true, plot
        end
    end
    return false
end

local function ActionChargeButton()
    while not stopRaid and isUiEnabled do 
        local inside, plot = isInAnyPlot()
        if inside then
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.CFrame = CFrame.new(tpTarget)
                task.wait(0.3) 
            end
        end

        local dashInterface = player.PlayerGui:FindFirstChild("DashInterface")
        local button = dashInterface and dashInterface:FindFirstChild("ChargeButton")

        if button then
            local insetTopLeft, _ = GuiService:GetGuiInset()
            local posX = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
            local posY = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2) + insetTopLeft.Y

            VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
            pcall(function()
                if getconnections then
                    for _, conn in pairs(getconnections(button.MouseButton1Down)) do conn:Fire() end
                    for _, conn in pairs(getconnections(button.InputBegan)) do 
                        conn:Fire({UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.Begin}) 
                    end
                elseif firesignal then
                    firesignal(button.MouseButton1Down)
                end
            end)

            task.wait(3.2)

            VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
            pcall(function()
                if getconnections then
                    for _, conn in pairs(getconnections(button.MouseButton1Up)) do conn:Fire() end
                    for _, conn in pairs(getconnections(button.InputEnded)) do 
                        conn:Fire({UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.End}) 
                    end
                elseif firesignal then
                    firesignal(button.MouseButton1Up)
                end
            end)
        end
        task.wait(0.5)
    end
    charging = false
end

local function PressEnter()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
    task.wait(0.03)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
end

local function HoldKey(key) VirtualInputManager:SendKeyEvent(true, key, false, game) end
local function ReleaseKey(key) VirtualInputManager:SendKeyEvent(false, key, false, game) end

local function AutoAlignLane(gui)
    local Tolerance = 1.0 
    while gui and gui.Parent and gui.Enabled and isUiEnabled do
        local character = player.Character
        if not character then task.wait() continue end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait() continue end

        local gameplayFolder = workspace:FindFirstChild("Gameplay")
        local slipstreams = gameplayFolder and gameplayFolder:FindFirstChild("Slipstreams")

        if slipstreams then
            local partLeft = slipstreams:GetChildren()[2]
            local partRight = slipstreams:FindFirstChild("Part")

            if partLeft and partRight then
                local centerPosition = (partLeft.Position + partRight.Position) / 2
                local centerCFrame = CFrame.new(centerPosition, centerPosition + partRight.CFrame.LookVector)
                local localPos = centerCFrame:PointToObjectSpace(hrp.Position)
                local offset = localPos.X

                if offset > Tolerance then
                    HoldKey(Enum.KeyCode.A)
                    ReleaseKey(Enum.KeyCode.D)
                elseif offset < -Tolerance then
                    HoldKey(Enum.KeyCode.D)
                    ReleaseKey(Enum.KeyCode.A)
                else
                    ReleaseKey(Enum.KeyCode.A)
                    ReleaseKey(Enum.KeyCode.D)
                end
            end
        end
        task.wait()
    end
    ReleaseKey(Enum.KeyCode.A)
    ReleaseKey(Enum.KeyCode.D)
end

HandleQTE = function(gui)
    if not isUiEnabled then return end
    task.spawn(AutoAlignLane, gui)

    while gui and gui.Parent and gui.Enabled and isUiEnabled do
        local hud = PlayerGui:FindFirstChild("HUD")
        if hud and hud.Enabled == true then hud.Enabled = false end

        local topbarStandard = PlayerGui:FindFirstChild("TopbarStandard")
        if topbarStandard and topbarStandard.Enabled == true then topbarStandard.Enabled = false end

        pcall(function()
            local topBarApp = CoreGui:FindFirstChild("TopBarApp") and CoreGui.TopBarApp:FindFirstChild("TopBarApp")
            if topBarApp and topBarApp.Enabled == true then topBarApp.Enabled = false end
        end)

        local foundButton = false
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("ImageButton") and obj.Visible and obj.AbsoluteSize.X > 0 then
                GuiService.SelectedObject = obj
                task.wait(0.05)
                PressEnter()
                task.wait(0.05)
                GuiService.SelectedObject = nil
                foundButton = true
                break
            end
        end
        if not foundButton or not gui.Enabled then break end
        task.wait(0.05) 
    end
    
    GuiService.SelectedObject = nil
    local hud = PlayerGui:FindFirstChild("HUD")
    if hud then hud.Enabled = true end

    local topbarStandard = PlayerGui:FindFirstChild("TopbarStandard")
    if topbarStandard then topbarStandard.Enabled = true end

    pcall(function()
        local topBarApp = CoreGui:FindFirstChild("TopBarApp") and CoreGui.TopBarApp:FindFirstChild("TopBarApp")
        if topBarApp then topBarApp.Enabled = true end
    end)
end

