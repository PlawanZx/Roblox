local charging = false

-- จุดที่ตั้งใจให้เป็นจุดปลอดภัย (Safe Zone)
local tpTarget = Vector3.new(4.511472702026367, 3.250000238418579, 14.231565475463867)

pcall(function()
    player.Idled:Connect(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end)

local function getModelBounds(model)
    if not model then return end
    return model:GetBoundingBox()
end

local function isInPlot(plot, pos)
    local cf, size = getModelBounds(plot)
    if not cf then return false end

    local rel = cf:PointToObjectSpace(pos)

    return math.abs(rel.X) <= size.X/2
        and math.abs(rel.Y) <= size.Y/2
        and math.abs(rel.Z) <= size.Z/2
end

local function isInAnyPlot()
    local char = player.Character
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return false end

    for _, plot in pairs(plotsFolder:GetChildren()) do
        if plot:IsA("Model") then
            if isInPlot(plot, hrp.Position) then
                return true, plot
            end
        end
    end

    return false
end

local function ActionChargeButton()

    while not stopRaid do
        
        local inside, plot = isInAnyPlot()
        if inside then
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.CFrame = CFrame.new(tpTarget)
                task.wait(0.3) 
            end
        end

        local dashInterface = player.PlayerGui:FindFirstChild("DashInterface")
        local button = dashInterface and dashInterface:FindFirstChild("ChargeButton")

        if button then

            local posX = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
            local posY = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2) + 36

            VirtualInputManager:SendMouseButtonEvent(
                posX,
                posY,
                0,
                true,
                game,
                1
            )

            task.wait(3.2)

            VirtualInputManager:SendMouseButtonEvent(
                posX,
                posY,
                0,
                false,
                game,
                1
            )
        end

        task.wait(0.5)
    end

    charging = false
end

local function PressEnter()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
    task.wait(0.03)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
end

local function HoldKey(key)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
end

local function ReleaseKey(key)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function AutoAlignLane(gui)
    local Tolerance = 1.0 
    
    while gui and gui.Parent and gui.Enabled do
        local character = player.Character
        if not character then task.wait() continue end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait() continue end

        local gameplayFolder = workspace:FindFirstChild("Gameplay")
        local slipstreams = gameplayFolder and gameplayFolder:FindFirstChild("Slipstreams")

        if slipstreams then
            local partLeft = slipstreams:GetChildren()[2]
            local partRight = slipstreams:FindFirstChild("Part")

            if partLeft and partRight then
                local centerPosition = (partLeft.Position + partRight.Position) / 2
                local centerCFrame = CFrame.new(centerPosition, centerPosition + partRight.CFrame.LookVector)
                local localPos = centerCFrame:PointToObjectSpace(hrp.Position)
                local offset = localPos.X

                if offset > Tolerance then
                    HoldKey(Enum.KeyCode.A)
                    ReleaseKey(Enum.KeyCode.D)
                elseif offset < -Tolerance then
                    HoldKey(Enum.KeyCode.D)
                    ReleaseKey(Enum.KeyCode.A)
                else
                    ReleaseKey(Enum.KeyCode.A)
                    ReleaseKey(Enum.KeyCode.D)
                end
            end
        end
        task.wait()
    end
    
    ReleaseKey(Enum.KeyCode.A)
    ReleaseKey(Enum.KeyCode.D)
end

local function HandleQTE(gui)
    task.spawn(AutoAlignLane, gui)

    while gui and gui.Parent and gui.Enabled do
        local hud = PlayerGui:FindFirstChild("HUD")
        if hud and hud.Enabled == true then
            hud.Enabled = false
        end

        local topbarStandard = PlayerGui:FindFirstChild("TopbarStandard")
        if topbarStandard and topbarStandard.Enabled == true then
            topbarStandard.Enabled = false
        end

        pcall(function()
            local topBarApp = CoreGui:FindFirstChild("TopBarApp") and CoreGui.TopBarApp:FindFirstChild("TopBarApp")
            if topBarApp and topBarApp.Enabled == true then
                topBarApp.Enabled = false
            end
        end)

        local foundButton = false

        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("ImageButton") and obj.Visible and obj.AbsoluteSize.X > 0 then
                GuiService.SelectedObject = obj
                task.wait(0.05)
                
                PressEnter()
                task.wait(0.05)
                
                GuiService.SelectedObject = nil
                foundButton = true
                break
            end
        end
        
        if not foundButton or not gui.Enabled then
            break
        end
        
        task.wait(0.05) 
    end
    
    GuiService.SelectedObject = nil
    
    local hud = PlayerGui:FindFirstChild("HUD")
    if hud then hud.Enabled = true end

    local topbarStandard = PlayerGui:FindFirstChild("TopbarStandard")
    if topbarStandard then topbarStandard.Enabled = true end

    pcall(function()
        local topBarApp = CoreGui:FindFirstChild("TopBarApp") and CoreGui.TopBarApp:FindFirstChild("TopBarApp")
        if topBarApp then topBarApp.Enabled = true end
    end)
end

if PlayerGui:FindFirstChild("BifrostImageQTE") then
    task.spawn(HandleQTE, PlayerGui.BifrostImageQTE)
end

PlayerGui.ChildAdded:Connect(function(child)
    if child.Name == "BifrostImageQTE" then
        task.wait(0.1)
        task.spawn(HandleQTE, child)
    end
end)

local function onTextChanged()
    if isLocked then return end 
    
    local currentText = txtTime.Text
    
    if string.find(currentText, "RAID AVAILABLE!") then
        if lastAction ~= "เขียว" then
            isLocked = true
            lastAction = "เขียว"
            
            task.wait(20) 
            
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:WaitForChild("HumanoidRootPart")
            
            stopRaid = false

            rootPart.CFrame = CFrame.new(tpTarget)

            task.wait(0.3)

            if not charging then
                charging = true

                task.spawn(function()
                    ActionChargeButton()
                end)
            end

            task.wait(0.5)
            isLocked = false
        end
        
    elseif string.find(currentText, "Raid in") then
        if lastAction ~= "แดง" then

            isLocked = true
            lastAction = "แดง"

            -- สั่งหยุดชาร์จ
            stopRaid = true

            -- ==========================================
            -- เพิ่มตรงนี้: ดึงตัวละครกลับมาจุดปลอดภัยทันทีเมื่อหยุดชาร์จ
            -- ==========================================
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.CFrame = CFrame.new(tpTarget)
            end
            -- ==========================================

            if player.Name == "Pongtakan26" then
                for i = 1, 10 do
                    pcall(function()
                        event:InvokeServer("Pay", "100Sx")
                    end)
                    task.wait(0.05)
                end
            else
                pcall(function()
                    event:InvokeServer("Pay", "100Qi")
                end)
            end
            
            task.wait(0.5)
            isLocked = false
        end
    end
end

txtTime:GetPropertyChangedSignal("Text"):Connect(onTextChanged)
onTextChanged()
