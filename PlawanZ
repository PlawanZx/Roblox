local PlotsFolder = workspace:FindFirstChild("Plots")
local function getClosestModelStands()
    local character = localPlayer.Character
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart or not PlotsFolder then return nil end

    local closestFolder
    local shortestDistance = math.huge
    for _, base in ipairs(PlotsFolder:GetChildren()) do
        local modelStands = base:FindFirstChild("ModelStands")
        local referencePart = base:FindFirstChildWhichIsA("BasePart")
        if referencePart and modelStands then
            local distance = (humanoidRootPart.Position - referencePart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestFolder = modelStands
            end
        end
    end
    return closestFolder, closestFolder and closestFolder.Parent.Name
end

if not _G.LockedModelStands then
    local target = getClosestModelStands()
    if target then _G.LockedModelStands = target end
end

local function safeTouch(hitbox)
    local character = localPlayer.Character
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart and hitbox and hitbox:IsA("BasePart") then
        local originalCFrame = hitbox.CFrame
        hitbox.CFrame = humanoidRootPart.CFrame
        task.wait(0.01)
        hitbox.CFrame = originalCFrame
    end
end

task.spawn(function()
    while true do
        if _G.AutoFarm then
            local targetModelStands = _G.LockedModelStands
            if targetModelStands then
                for _, child in ipairs(targetModelStands:GetChildren()) do
                    if not _G.AutoFarm then break end
                    local standClaim = child:FindFirstChild("StandClaim")
                    if standClaim then
                        local hitbox = standClaim:FindFirstChild("StandClaimHitbox")
                        if hitbox then
                            safeTouch(hitbox)
                            task.wait(0.15)
                        end
                    end
                end
            end
        end
        task.wait(1)
    end
end)

