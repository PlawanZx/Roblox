            VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
            pcall(function()
                if getconnections then
                    for _, conn in pairs(getconnections(button.MouseButton1Down)) do conn:Fire() end
                    for _, conn in pairs(getconnections(button.InputBegan)) do 
                        conn:Fire({UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.Begin}) 
                    end
                elseif firesignal then
                    firesignal(button.MouseButton1Down)
                end
            end)

            task.wait(3.2)

            VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
            pcall(function()
                if getconnections then
                    for _, conn in pairs(getconnections(button.MouseButton1Up)) do conn:Fire() end
                    for _, conn in pairs(getconnections(button.InputEnded)) do 
                        conn:Fire({UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.End}) 
                    end
                elseif firesignal then
                    firesignal(button.MouseButton1Up)
                end
            end)
        end
        task.wait(0.5)
    end
    chargingRaid = false
end

task.spawn(function()
    local txtTime = workspace:WaitForChild("Map"):WaitForChild("Event_Objects"):WaitForChild("Storm_Breaker"):WaitForChild("Handle"):WaitForChild("ChargeBarGui"):WaitForChild("ChargeBarContainer"):WaitForChild("Txt_Time")
    local event = ReplicatedStorage:WaitForChild("Events"):WaitForChild("StormBreakerChargeFunction")

    local function onTextChanged()
        if raidIsLocked or not _G.AutoRaidEnabled then return end 
        local currentText = txtTime.Text
        
        if string.find(currentText, "RAID AVAILABLE!") then
            if raidLastAction ~= "เขียว" then
                raidIsLocked = true
                raidLastAction = "เขียว"
                task.wait(20) 
                
                local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                local rootPart = character:WaitForChild("HumanoidRootPart")
                
                stopRaid = false
                rootPart.CFrame = CFrame.new(raidTpTarget)
                task.wait(0.3)

                if not chargingRaid then
                    chargingRaid = true
                    task.spawn(ActionChargeButtonRaid)
                end

                task.wait(0.5)
                raidIsLocked = false
            end
            
        elseif string.find(currentText, "Raid in") then
            if raidLastAction ~= "แดง" then
                raidIsLocked = true
                raidLastAction = "แดง"
                stopRaid = true

                local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then rootPart.CFrame = CFrame.new(raidTpTarget) end

                for i = 1, currentPayTimes do
                    pcall(function() event:InvokeServer("Pay", currentPayPayload) end)
                    if currentPayTimes > 1 then task.wait(0.05) end
                end
                
                task.wait(0.5)
                raidIsLocked = false
            end
        end
    end

    _G.CheckRaidText = onTextChanged
    txtTime:GetPropertyChangedSignal("Text"):Connect(onTextChanged)
end)

