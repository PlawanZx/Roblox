task.spawn(function()
    while task.wait(0.2) do
        if Toggles.AutoX2 then
            local s, button = pcall(function()
                return player.PlayerGui.OnScreenEffects.DoubleTemplate.Button
            end)
            if s and button and button:IsA("ImageButton") and button.Visible then
                local tx = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
                local ty = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2) + 36
                vim:SendMouseButtonEvent(tx, ty, 0, true, game, 1)
                task.wait(0.05)
                vim:SendMouseButtonEvent(tx, ty, 0, false, game, 1)
                print("AutoX2: กดปุ่มสำเร็จ!")
                task.wait(1.5)
            end
        end
    end
end)

task.spawn(function()
    local targetName = "CollectPad"
    local maxDistance = 60
    while task.wait(0.5) do
        if Toggles.AutoCollect then
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                local myBase = rootPart.Position
                for _, item in pairs(workspace.Live.Debris:GetChildren()) do
                    if not Toggles.AutoCollect then break end
                    if item.Name == targetName and item:GetPivot() then
                        local dist = (item:GetPivot().Position - myBase).Magnitude
                        if dist <= maxDistance then
                            local cur = rootPart.CFrame
                            rootPart.CFrame = item:GetPivot()
                            task.wait(0.05)
                            rootPart.CFrame = cur
                        end
                    end
                end
            end
        end
    end
end)
