createButton("Hide HUD", 130, "HideHUD", function(isHiding)
    local huds = {
        playerGui:FindFirstChild("TopHud"),
        playerGui:FindFirstChild("BottomHud"),
        playerGui:FindFirstChild("BottomLeftHud"),
        playerGui:FindFirstChild("BottomRightHud"),
        playerGui:FindFirstChild("CenterHud"),
        playerGui:FindFirstChild("LeftHud"),
        playerGui:FindFirstChild("RightHud")
    }
    local isVisible = not isHiding
    for _, hud in pairs(huds) do
        if hud then
            if hud:IsA("ScreenGui") then hud.Enabled = isVisible
            elseif hud:IsA("GuiObject") then hud.Visible = isVisible
            end
        end
    end
end)

