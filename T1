local function onTextChanged()
    if isLocked or not isUiEnabled then return end 
    
    local currentText = txtTime.Text
    
    if string.find(currentText, "RAID AVAILABLE!") then
        if lastAction ~= "เขียว" then
            isLocked = true
            lastAction = "เขียว"
            task.wait(20) 
            
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:WaitForChild("HumanoidRootPart")
            
            stopRaid = false
            rootPart.CFrame = CFrame.new(tpTarget)
            task.wait(0.3)

            if not charging then
                charging = true
                task.spawn(function()
                    ActionChargeButton()
                end)
            end

            task.wait(0.5)
            isLocked = false
        end
        
    elseif string.find(currentText, "Raid in") then
        if lastAction ~= "แดง" then
            isLocked = true
            lastAction = "แดง"
            stopRaid = true

            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.CFrame = CFrame.new(tpTarget)
            end

            if player.Name == "Rlyzer" then
                for i = 1, 10 do
                    pcall(function() event:InvokeServer("Pay", "100Sx") end)
                    task.wait(0.05)
                end
            else
                pcall(function() event:InvokeServer("Pay", "100Qi") end)
            end
            
            -- [แก้ไข] เปลี่ยนมากดเลข 1 แค่ 1 ครั้งต่อรอบรอ
            task.spawn(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
            end)
            
            task.wait(0.5)
            isLocked = false
        end
    end
end

txtTime:GetPropertyChangedSignal("Text"):Connect(onTextChanged)

